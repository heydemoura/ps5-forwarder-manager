#
# Copy this file to .env. The local .env file is ignored by Git and read by
# Make; keep application identity and release metadata in sce_sys/param.json.

PS5_HOST=192.168.1.100
FTP_PORT=2121
DEPLOY_FORMAT=folder
DEPLOY_DRY_RUN=0

# Extra PacBrew packages; libcurl is always linked.
# PACBREW_PACKAGES=sdl2 openssl

# Your SteamGridDB API key (https://www.steamgriddb.com/profile/preferences/api),
# built into the app for its image search. Never commit it.
# STEAMGRIDDB_API_KEY=

# Defaults to all available logical CPUs; lower this on memory-limited hosts.
# BUILD_JOBS=8
# USE_CCACHE=0
